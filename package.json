{
  "name": "event-os-admin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --config apps/vite.config.ts apps",
    "build": "vite build --config apps/vite.config.ts apps && tsc --noEmit -p apps/tsconfig.json",
    "typecheck": "vite build --config apps/vite.config.ts --emptyOutDir false apps && tsc --noEmit -p apps/tsconfig.json --pretty",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.120.0",
    "@tanstack/react-table": "^8.21.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-plugin": "^1.120.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
